{
  "name": "@brambles-ai/aix",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Brambles.ai",
  "homepage": "https://www.brambles.ai/agentic-intent-exchange/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brambles-ai/aix-sdks.git",
    "directory": "packages/aix-js"
  },
  "bugs": {
    "url": "https://github.com/brambles-ai/aix-sdks/issues"
  },
  "keywords": [
    "aix",
    "agentic-intent-exchange",
    "agentic-commerce",
    "brambles"
  ],
  "publishConfig": {
    "access": "public"
  },
  "description": "Client for the Agentic Intent Exchange (AIX) HTTPS API: send intent, report handoffs, receive and verify deliveries.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vercel-ai": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js"
    },
    "./openai-agents": {
      "types": "./dist/adapters/openai-agents.d.ts",
      "import": "./dist/adapters/openai-agents.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "jose": "^6.0.0"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0",
    "@openai/agents": ">=0.1.0",
    "ai": ">=5.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/core": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "^1.3.0",
    "@openai/agents": "^0.21.0",
    "@types/node": "^22.20.5",
    "ai": "^7.0.150",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "zod": "^4.6.7"
  }
}
